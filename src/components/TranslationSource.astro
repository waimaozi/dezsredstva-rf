---
interface Props {
  translation: {
    issue?: string;
    publisher: string;
    originalTitle: string;
    authors: string;
    originalDate: string;
    scope: string;
    license: string;
    licenseUrl: string;
    originalPdf?: string;
    originalHtml?: string;
    offlineHtml?: string;
  };
}
const { translation: t } = Astro.props;
---
<section class="translation-source" aria-label="О переводе">
  <p class="eyebrow">Зарубежная практика · перевод с английского</p>
  <p><strong>{t.publisher}</strong> · {t.originalDate}</p>
  <p class="translation-scope">{t.scope}</p>
  <details>
    <summary>Авторы, оригинал и условия использования</summary>
    <p lang="en">{t.originalTitle}</p>
    <p><strong>Авторы:</strong> {t.authors}.</p>
    <p><a href={t.licenseUrl}>{t.license}</a>.</p>
    <p>Перевод подготовлен и сопоставлен с оригиналом с помощью ИИ. Независимая профильная рецензия не проводилась. Редакционные дополнения выделены отдельно.</p>
  </details>
  <div class="reading-actions">
    {t.issue && <a href={`/vypuski/${t.issue}/`}>← Весь выпуск</a>}
    {!t.issue && <a href="/perevody/">← Все переводы</a>}
    {t.originalPdf && <a href={t.originalPdf} download data-translation-download="original">Скачать оригинал PDF</a>}
    {t.originalHtml && <a href={t.originalHtml} download data-translation-download="original">Скачать исходный раздел</a>}
    {t.offlineHtml && <a href={t.offlineHtml} download data-translation-download="russian">Читать по-русски без интернета</a>}
    {t.issue && <a href={`/downloads/${t.issue}/vypusk.pdf`} download data-translation-download="russian">Выпуск по-русски PDF</a>}
    <button type="button" class="print-article">Распечатать</button>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-translation-download]").forEach((link) => {
    link.addEventListener("click", () => {
      const analytics = (window as unknown as { ym?: (...args: unknown[]) => void }).ym;
      analytics?.(107711899, "reachGoal", "translation_download", { format: link.dataset.translationDownload });
    });
  });
  document.querySelectorAll<HTMLButtonElement>(".print-article").forEach((button) => {
    button.addEventListener("click", () => window.print());
  });
</script>
