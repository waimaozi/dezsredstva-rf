---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import DownloadTracking from "../../components/DownloadTracking.astro";
import ResearchFeedback from "../../components/ResearchFeedback.astro";
import collection from "../../data/listeria-collection.json";

const all = await getCollection("articles");
const cases = collection.cases.map((item) => {
  const article = all.find((a) => a.id === item.slug);
  if (!article?.data.translation?.translatedPdf) throw new Error(`Missing collection PDF: ${item.slug}`);
  return { ...item, translation: article.data.translation };
});
const site = "https://дезинфицирующиесредства.рф";
const structuredData = {
  "@context": "https://schema.org", "@type": "CollectionPage",
  "@id": `${site}/vypuski/listeriya/`, name: collection.title,
  description: collection.description, inLanguage: "ru", datePublished: "2026-10-18",
  mainEntity: { "@type": "ItemList", numberOfItems: cases.length,
    itemListElement: cases.map((item, i) => ({ "@type": "ListItem", position: i + 1,
      name: item.originalTitle, url: `${site}/articles/${item.slug}/` })) }
};
const downloads = "/downloads/collections/listeriya";
---
<Layout title={collection.title} description={collection.description} pathname="/vypuski/listeriya/" structuredData={structuredData}>
  <div data-research-content>
  <section class="section-shell p-6 sm:p-10">
    <p class="eyebrow">Тематическая подборка · 18 октября 2026</p>
    <h1 class="section-title mt-4">{collection.title}</h1>
    <p class="section-copy mt-5">{collection.intro}</p>
    <div class="reading-actions mt-6">
      <a class="primary-action" href={`${downloads}/collection.pdf`} download data-translation-download="collection-pdf">Вся подборка PDF</a>
      <a href={`${downloads}/collection.zip`} download data-translation-download="collection-zip">Переводы и оригиналы ZIP</a>
      <a href={`${downloads}/collection.html`} download data-translation-download="collection-html">Читать без интернета HTML</a>
    </div>
    <p class="mt-4 text-sm text-slate-600">PDF и HTML содержат сравнение и три перевода с рисунками и таблицами. В ZIP также входят отдельные переводы PDF, оригиналы HTML и два доступных оригинала PDF. Для чтения скачанных материалов иностранные сайты не требуются.</p>
    <nav class="mt-6 flex flex-wrap gap-4" aria-label="Разделы подборки">
      <a href="#sravnenie" class="text-sky-700 underline">Сравнить доказательства</a>
      {cases.map((item) => <a class="text-sky-700 underline" href={`#${item.id}`}>{item.title}</a>)}
    </nav>
  </section>
  <section id="sravnenie" class="section-shell mt-8 scroll-mt-40 p-6 sm:p-8">
    <p class="eyebrow">Редакционное сравнение</p>
    <h2 class="mt-3 text-2xl font-semibold">Что именно подтверждено в каждом случае</h2>
    <p class="section-copy mt-4">{collection.editorialNote}</p>
    <p class="mt-4 text-sm text-slate-600 lg:hidden">На узком экране таблицу можно прокрутить вправо.</p>
    <div class="comparison-scroll mt-6" role="region" aria-label="Сравнение трёх расследований; таблицу можно прокрутить" tabindex="0">
      <table>
        <caption class="sr-only">Вопрос, доказательства и ограничения каждого расследования</caption>
        <thead><tr><th scope="col">Расследование</th><th scope="col">Какие данные сопоставили</th><th scope="col">Что установили</th><th scope="col">Граница вывода</th></tr></thead>
        <tbody>{cases.map((item) => <tr>
          <th scope="row"><a href={`#${item.id}`}>{item.title}</a><span>{item.question}</span></th>
          <td>{item.compare}</td><td>{item.evidence}</td><td>{item.limit}</td>
        </tr>)}</tbody>
      </table>
    </div>
  </section>
  <section class="mt-8 grid gap-6" aria-label="Три перевода">
    {cases.map((item, i) => <article id={item.id} class="section-shell scroll-mt-40 p-6 sm:p-8">
      <p class="eyebrow">0{i + 1} · {item.publisher} · {item.year}</p>
      <h2 class="mt-3 text-2xl font-semibold"><a href={`/articles/${item.slug}/`}>{item.title}</a></h2>
      <p class="mt-3 font-medium">{item.question}</p>
      <p class="section-copy mt-3">{item.reader}. {item.readFor}</p>
      <p class="mt-4 text-sm text-slate-600">{item.translation.scope}</p>
      <div class="reading-actions mt-5">
        <a class="primary-action" href={`/articles/${item.slug}/`}>Читать перевод</a>
        <a href={item.translation.translatedPdf} download data-translation-download="russian-pdf">Перевод PDF</a>
        <a href={item.translation.originalHtml} download data-translation-download="original">Оригинал HTML</a>
      </div>
      <details class="mt-4"><summary>Источник и условия использования</summary>
        <p class="mt-3" lang="en">{item.originalTitle}</p>
        <p class="mt-2">{item.translation.authors}</p>
        <p class="mt-2"><a class="underline" href={item.source}>Публикация издателя</a> · <a class="underline" href={`https://doi.org/${item.doi}`}>DOI: {item.doi}</a></p>
        <p class="mt-2"><a class="underline" href={item.translation.licenseUrl}>{item.translation.license}</a></p>
      </details>
    </article>)}
  </section>
  <section class="section-shell mt-8 p-6 sm:p-8">
    <h2 class="text-2xl font-semibold">Как подготовлена подборка</h2>
    <p class="section-copy mt-4">Сами исследования опубликованы в 2017, 2019 и 2021 годах. Их выводы относятся к описанным событиям. В переводах сохранены основной текст, таблицы, рисунки, библиография и оговорки авторов. Русские пояснения к обозначениям на рисунках и сравнение расследований выделены как редакционные дополнения.</p>
    <p class="section-copy mt-4">Переводы и сопоставление с источниками выполнены с помощью ИИ. Независимая профильная рецензия не проводилась. Подборка предназначена для чтения и обсуждения исследований; она не задаёт режим обработки или программу производственного контроля.</p>
    <p class="mt-4"><a class="text-sky-700 underline" href="/perevody/">Все переводы по рабочим вопросам →</a></p>
  </section>
  </div>
  <ResearchFeedback kind="collection" />
  <DownloadTracking />
</Layout>
<style>
  .comparison-scroll { overflow-x:auto; }
  table { width:100%; min-width:760px; border-collapse:collapse; font-size:.95rem; line-height:1.65; }
  th,td { padding:1rem; border:1px solid #d4e2ea; vertical-align:top; text-align:left; }
  thead th { background:#edf6fa; }
  tbody th { min-width:170px; }
  tbody th a { color:#036b9a; text-decoration:underline; }
  tbody th span { display:block; margin-top:.7rem; font-weight:400; }
  td { min-width:180px; }
</style>
