---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { normalizeTag, sortArticlesByDate } from "../../lib/articles";
import { getEditorialReview } from "../../lib/editorial-review.mjs";

const articles = sortArticlesByDate(await getCollection("articles"));
const groups = [
  { id: "perevody", title: "Переводы исследований и расследований", entries: articles.filter((a) => a.data.translation) },
  { id: "daydzhesty", title: "Архив исследовательских дайджестов", entries: articles.filter((a) => !a.data.translation) }
];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ru-RU", {
    day: "numeric",
    month: "long",
    year: "numeric"
  }).format(date);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Статьи о дезинфекции",
  url: "https://дезинфицирующиесредства.рф/articles/",
  inLanguage: "ru"
};
---

<Layout
  title="Статьи о дезинфекции"
  description="Архив статей о дезинфекции: исследования, переводные дайджесты и практические обзоры."
  pathname="/articles/"
  structuredData={structuredData}
>
  <section class="section-shell p-8 sm:p-10">
    <span class="eyebrow">Архив</span>
    <h1 class="section-title mt-4">Статьи о дезинфекции</h1>
    <p class="section-copy mt-4 max-w-3xl">
      Переводы с указанным объёмом и материалами для чтения без интернета, а также ранее опубликованные краткие дайджесты исследований.
    </p>
    <nav class="mt-5 flex flex-wrap gap-5" aria-label="Форматы публикаций">
      <a class="text-sky-700 underline" href="/perevody/">Выбрать перевод по рабочему вопросу</a>
      <a class="text-sky-700 underline" href="#daydzhesty">Архив дайджестов ({groups[1].entries.length})</a>
    </nav>
  </section>

  {groups.map((group) => <section id={group.id} class="mt-10 grid scroll-mt-40 gap-6" aria-label={group.title}>
    <h2 class="section-title">{group.title}</h2>
    {group.entries.map((article) => (
      <article class="section-shell group p-6 sm:p-8">
        <p class="text-sm font-medium text-sky-700">{formatDate(article.data.date)}</p>
        <h3 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900"><a class="hover:text-sky-800" href={`/articles/${article.id}/`}>{article.data.title}</a></h3>
        {getEditorialReview(article.id) && <p class="mt-3 font-medium text-amber-800">Архивная заметка · источники требуют уточнения</p>}
        <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">{article.data.description}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {article.data.tags.map((tag) => {
            const normalizedTag = normalizeTag(tag);

            return (
              <a
                href={`/tags/${normalizedTag.slug}/`}
                class="rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-medium text-sky-700 transition hover:border-sky-300 hover:bg-sky-100"
              >
                #{normalizedTag.label}
              </a>
            );
          })}
        </div>
        <a href={`/articles/${article.id}/`} class="mt-5 inline-flex text-sm font-semibold text-sky-700 transition group-hover:text-sky-900">
          Открыть материал →
        </a>
      </article>
    ))}
  </section>)}
</Layout>
