---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getArticleAbsoluteUrl } from "../lib/articles";
const articles = (await getCollection("articles"))
  .filter((a) => a.data.translation)
  .sort((a, b) => (b.data.updated ?? b.data.date).getTime() - (a.data.updated ?? a.data.date).getTime());
const topics = [
  {
    id: "ispytaniya-dezinfekcii", title: "Что меняет результат испытания дезинфекции",
    description: "Лабораторный эксперимент с микропластиком: разные результаты для тепла, УФ и химической обработки. Какие условия проверены и что пока нельзя переносить на производство.",
    ids: ["mikroplastik-kak-faktor-rezistentnosti-patogenov-novye-dannye-dlya-pishchevykh-p"]
  },
  {
    id: "otbor-prob", title: "Отбор проб и отрицательные результаты",
    description: "Когда и где отбирали пробы, что измерял метод и почему отрицательный результат мог не закрыть расследование.",
    ids: ["2026-10-17-listeriya-v-apparate-dlya-molochnyh-kokteyley", "2026-10-17-listeriya-gotovye-salaty-proizvodstvennyy-kontrol", "2026-10-15-chto-pokazyvaet-lyuminometr"]
  },
  {
    id: "pishchevye-proizvodstva", title: "Листерия на производстве",
    description: "Расследования на молочном, рыбном и дрожжевом производствах: связь продукции и производственной среды, прослеживаемость и пределы доказательств.",
    ids: ["2026-10-17-listeriya-syr-pasterizovannoe-moloko", "2026-10-17-listeriya-kopchenyy-losos-dlitelnaya-vspyshka", "2026-10-16-listerioz-hlebopekarnye-drozhzhi"]
  },
  {
    id: "oborudovanie", title: "Оборудование как источник загрязнения",
    description: "Что нашли в стиральной машине, на линии фасовки антисептика и на шоколадной фабрике. В каждом случае — отдельные условия и степень уверенности авторов.",
    ids: ["2026-10-17-stiralnaya-mashina-istochnik-klebsiella", "2026-10-17-zagryaznennyy-hlorgeksidin-liniya-fasovki", "2026-10-17-salmonella-na-shokoladnoy-fabrike"]
  },
  {
    id: "bioplenki-i-voda", title: "Биоплёнки, вода и загрязнённые расходные материалы",
    description: "Что можно узнать из проб производственной среды и необычных результатов посевов. Где исследователям удалось найти источник, а где он остался предположением.",
    ids: ["2026-10-13-bioplenki-myasopererabotka-fsa", "2026-10-13-voda-i-inzhektor-kt", "2026-10-13-zagryaznennyj-sterilnyj-gel"]
  }
].map((topic) => ({ ...topic, articles: topic.ids.map((id) => {
  const article = articles.find((a) => a.id === id);
  if (!article) throw new Error(`Missing curated translation: ${id}`);
  return article;
}) }));
const structuredData = {
  "@context": "https://schema.org", "@type": "CollectionPage",
  "@id": "https://дезинфицирующиесредства.рф/perevody/",
  name: "Зарубежные исследования и расследования по-русски", inLanguage: "ru",
  mainEntity: {
    "@type": "ItemList", numberOfItems: articles.length,
    itemListElement: articles.map((a, i) => ({ "@type": "ListItem", position: i + 1, name: a.data.title, url: getArticleAbsoluteUrl(a) }))
  }
};
---
<Layout title="Исследования по пищевой безопасности и гигиене — переводы" description="Зарубежные научные статьи и расследования по-русски: листерия, отбор проб, производственная среда и загрязнение оборудования. Полные тексты, таблицы и оригиналы для скачивания." pathname="/perevody/" structuredData={structuredData}>
  <section class="section-shell p-8 sm:p-10">
    <span class="eyebrow">Зарубежная практика по-русски</span>
    <h1 class="section-title mt-4">Исследования, которые пригодятся в работе</h1>
    <p class="section-copy mt-5">Находим интересные зарубежные исследования, расследования вспышек и технические материалы для технологов, лабораторий, специалистов по качеству, пищевой безопасности, ветеринарии и гигиене. Переводим их на русский, сохраняя методы, результаты и ограничения выводов.</p>
    <p class="section-copy mt-4">Выбираем материалы по их пользе для профессиональной работы. У каждого перевода указаны источник, дата и объём. Материалы можно скачать и читать без доступа к зарубежному сайту.</p>
    <nav aria-label="Вопросы для выбора исследования" class="mt-6 flex flex-wrap gap-4">
      {topics.map((topic) => <a class="text-sky-700 underline" href={`#${topic.id}`}>{topic.title}</a>)}
      <a class="text-sky-700 underline" href="#vse-perevody">Все переводы</a>
    </nav>
  </section>
  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    {topics.map((topic) => (
      <section id={topic.id} class="section-shell scroll-mt-40 p-6">
        <h2 class="text-2xl font-semibold">{topic.title}</h2>
        <p class="section-copy mt-4">{topic.description}</p>
        <ul class="mt-5 space-y-4">
          {topic.articles.map((a) => <li>
            {a.data.readerQuestion && <p class="mb-2 font-medium text-slate-900">{a.data.readerQuestion}</p>}
            <a class="text-sky-700 underline underline-offset-4" href={`/articles/${a.id}/`}>{a.data.title}</a>
          </li>)}
        </ul>
      </section>
    ))}
  </div>
  <h2 id="vse-perevody" class="section-title mt-10 scroll-mt-40">Все переводы</h2>
  <section class="mt-8 grid gap-6 md:grid-cols-2" aria-label="Переводы">
    {articles.map((article) => (
      <a class="section-shell p-6 hover:border-sky-300" href={`/articles/${article.id}/`}>
        <p class="text-sm text-sky-700">{article.data.translation?.publisher}</p>
        <h3 class="mt-3 text-2xl font-semibold">{article.data.title}</h3>
        <p class="section-copy mt-3">{article.data.description}</p>
        <span class="mt-5 inline-block font-semibold text-sky-700">Открыть перевод →</span>
      </a>
    ))}
  </section>
  <section class="section-shell mt-8 p-8">
    <h2 class="text-2xl font-semibold">Как готовим переводы</h2>
    <p class="section-copy mt-4">Переводим доступный текст источника, сохраняем таблицы и ограничения выводов. Если публикуется отдельный раздел, это указано рядом с заголовком. Перевод и сопоставление с оригиналом выполняются с помощью ИИ; независимая профильная рецензия не проводилась.</p>
    <p class="section-copy mt-4">Зарубежные рекомендации относятся к условиям, описанным авторами. Они не заменяют инструкцию к конкретному средству или оборудованию и требования, действующие в вашей организации.</p>
    <p class="section-copy mt-4"><a class="underline" href="/about/#translation-policy">Редакционные правила и исправления</a></p>
    <a class="mt-5 inline-block text-sky-700 underline" href="/vypuski/2026-10/">Первый выпуск: три расследования и исследования, PDF и комплект для чтения офлайн</a>
  </section>
</Layout>
